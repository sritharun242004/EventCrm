# Neon Postgres (Eventbot CRM)
# Copy to .env.local and fill in the real credentials — never commit .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# Direct URL is used for migrations (Prisma bypasses the connection pooler here)
DIRECT_URL="postgresql://USER:PASSWORD@HOST_UNPOOLED/DB?sslmode=require&channel_binding=require"
