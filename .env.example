# --- Database (Neon Postgres) ---
# Copy this file to .env.local and fill in real credentials. Never commit .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST_UNPOOLED/DB?sslmode=require&channel_binding=require"

# --- Auth.js v5 (staff RBAC) ---
AUTH_SECRET=""              # generate: `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"

# Legacy env-auth fallback — set to "on" to keep the old single-user path
# alive during Phase A cutover; "off" once every real staff user is invited.
LEGACY_AUTH="off"
AUTH_EMAIL=""               # legacy only; delete after LEGACY_AUTH=off
AUTH_PASSWORD=""            # legacy only; delete after LEGACY_AUTH=off

# Seeded first CEO — bootstrap only. Rotate this password immediately after first login.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
SEED_ADMIN_PASSWORD=""

# Email (Resend) — invite links + password-reset links
RESEND_API_KEY=""
EMAIL_FROM="Eventbot <no-reply@example.com>"
